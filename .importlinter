[importlinter]
root_packages =
    ailab_vision
    ailab_nlp
    ailab_ml
    ailab_timeseries
    ailab_finance
    ailab_climate
    ailab_mental_health

[importlinter:contract:packages-do-not-import-frameworks]
name = Packages must never import frameworks (ADR-0001)
type = forbidden
source_modules =
    ailab_vision
    ailab_nlp
    ailab_ml
    ailab_timeseries
forbidden_modules =
    ailab_finance
    ailab_climate
    ailab_mental_health

[importlinter:contract:frameworks-are-independent]
name = Frameworks must not import each other
type = independence
modules =
    ailab_finance
    ailab_climate
    ailab_mental_health
